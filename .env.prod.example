# 운영 전용 값 목록.
# 실제 .env.prod(진짜 값)는 절대 레포에 커밋하지 않는다 — EC2에만 존재한다.
# 최초 배포 시 EC2에서 이 파일을 ~/app/.env.prod로 복사하고 값을 채운다.
#   scp -i <key.pem> .env.prod.example ubuntu@<EC2_IP>:~/app/.env.prod
#   (그 다음 EC2에서 nano/vi로 값 채우기)

# Django
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=<EC2 Elastic IP 또는 도메인, 쉼표로 여러 개 가능>

# Postgres
POSTGRES_DB=settlement
POSTGRES_USER=settlement
POSTGRES_PASSWORD=<운영용 비밀번호로 변경>

# ai(FastAPI) ↔ core(Django) 서비스 계정 — 양쪽 값이 반드시 같아야 한다
AI_SERVICE_USER=rule-agent
AI_SERVICE_PASSWORD=<운영용 비밀번호로 변경>

# 외부 API 키
OPENAI_API_KEY=
KAKAO_REST_API_KEY=
