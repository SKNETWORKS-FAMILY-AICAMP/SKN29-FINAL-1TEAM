# 로컬 개발용 환경변수 예시.
#   cp .env.example .env  후 필요한 값만 채우면 됩니다.
#   (docker-compose가 이 값들을 각 서비스로 주입)

# ── PostgreSQL ──────────────────────────────
POSTGRES_DB=settlement
POSTGRES_USER=settlement
POSTGRES_PASSWORD=settlement

# ── Django (core) ───────────────────────────
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# ── FastAPI (ai) ────────────────────────────
# OpenAI(LLM·비전)는 실제 Agent 동작 시에만 필요. 스캐폴드 부팅에는 비어 있어도 됨.
OPENAI_API_KEY=

# ── Rule Agent (규정 문서 → 룰 그래프 생성) ──
# Rule Agent는 사람 세션 없이 룰 콘솔 API에 DRAFT를 쓴다. capability `rule_view` 하나만
# 가진 전용 서비스 계정으로 JWT를 받으며, core(계정 생성)와 ai(로그인)가 같은 값을 본다.
#   1) 아래 비밀번호를 채우고
#   2) docker compose exec core python manage.py ensure_service_account
# 비워 두면 룰 생성이 401(인증 실패)로 명시적으로 실패한다 — 조용히 익명으로 넘어가지 않는다.
RULE_AGENT_SERVICE_USER=rule-agent
RULE_AGENT_SERVICE_PASSWORD=
RULE_AGENT_MODEL=gpt-4o-mini

# ── Web (vite) ──────────────────────────────
# 기본값 /api → Nginx(8080) 또는 vite proxy(5173) 경유로 Django에 도달.
VITE_API_BASE_URL=/api
# 데이터 소스: true=목업(백엔드 불필요) / false=실제 Django(/api) 연동
VITE_USE_MOCK=true
