# 로컬 개발용 환경변수 예시.
#   cp .env.example .env  후 필요한 값만 채우면 됩니다.
#   (docker-compose가 이 값들을 각 서비스로 주입)

# ── PostgreSQL ──────────────────────────────
POSTGRES_DB=settlement
POSTGRES_USER=settlement
POSTGRES_PASSWORD=settlement

# ── Django (core) ───────────────────────────
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# ── FastAPI (ai) ────────────────────────────
# OpenAI(LLM·비전)는 실제 Agent 동작 시에만 필요. 스캐폴드 부팅에는 비어 있어도 됨.
OPENAI_API_KEY=

# ── AI 서비스 계정 (ai → core 쓰기) ──
# ai(FastAPI)는 사람 세션이 없다. 룰 그래프 DRAFT 저장·규정 적재 결과 회신처럼 core에
# **쓰기**를 할 때 이 계정 하나로 JWT를 받는다. **Agent마다 계정을 나누지 않는다** —
# 권한이 같고(capability `rule_view` 하나뿐), 계정을 늘리면 어긋날 자리만 늘어난다.
#
# core(계정 생성)와 ai(로그인)가 **같은 값**을 봐야 한다. 순서:
#   1) 아래 비밀번호를 아무 값이나 채운다 (예: ai-service-local-pw)
#   2) docker compose up -d --force-recreate core ai      ← env 변경은 컨테이너 재생성 필요
#   3) docker compose exec core python manage.py ensure_service_account
#   진단: docker compose exec core python manage.py ensure_service_account --check
#
# 비워 두면 계정 생성이 **에러로 멈춘다** — 예전엔 로그인 불가 계정을 만들고 넘어가서,
# 나중에 ai가 원인과 동떨어진 401("No active account found")을 받았다.
AI_SERVICE_USER=rule-agent
AI_SERVICE_PASSWORD=
RULE_AGENT_MODEL=gpt-4o-mini

# ── 로깅 ──
# 컨테이너 로그는 호스트 `./logs/`에 파일로도 쌓인다 (core.log / ai.log, 5MB×3 로테이션).
LOG_LEVEL=INFO

# ── docling 모킹 (개발 전용) ──
# 파싱 단계만 `docling_eval/output` 덤프로 대체한다. docling이 깨졌거나 느릴 때
# 그 뒤 체인(교정→청킹→임베딩→적재→조항→룰 트리거)을 그대로 시험하기 위한 스위치다.
#
# ⚠️ 켜면 업로드한 **파일 내용이 무시되고 문서명으로만** 덤프를 고른다.
#    문서명이 정확히 일치해야 하며(넘겨짚지 않는다), 안 맞으면 적재가 실패한다.
#    적재 결과에 경고가 실려 화면에 노란 배너로 뜨고, 벡터 doc_id도 `dump:<이름>`이라
#    실물과 구분된다. **운영에서는 절대 켜지 말 것.**
#
# 사용 가능한 문서명(11종): 법인카드_사용규정 · 업무추진비_사용규정 · 출장비_사용규정 ·
#   회식_운영규정 · 부서소개 · 조직도 · 직급체계 · 조직설계_상세기획서 ·
#   법인세법 · 부가가치세법 · 여신전문금융업법
DOCLING_MOCK=
DOCLING_MOCK_DUMP=/data/docling_eval/output

# ── Web (vite) ──────────────────────────────
# 기본값 /api → Nginx(8080) 또는 vite proxy(5173) 경유로 Django에 도달.
VITE_API_BASE_URL=/api
# 데이터 소스: true=목업(백엔드 불필요) / false=실제 Django(/api) 연동
VITE_USE_MOCK=true
