# 운영용 web+nginx 통합 이미지.
# React 빌드 산출물을 nginx 이미지 안에 포함시켜, 별도 web 컨테이너 없이
# nginx가 정적 서빙까지 겸한다(docker-compose.prod.yml에는 web 서비스가 없다).
#
# 빌드 컨텍스트는 레포 루트여야 한다(apps/web과 infra/nginx를 모두 COPY하므로):
#   docker build -f infra/nginx/Dockerfile.prod -t <name> .

FROM node:20-alpine AS build
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/ .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY infra/nginx/nginx.prod.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
